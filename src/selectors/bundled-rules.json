{
  "version": "2026.05.16-bundled",
  "updated": "2026-05-16",
  "notes": "Day-one curated set. Maintained at github.com/krumb/list.",
  "rules": [
    { "domain": "*.nytimes.com",       "selectors": ["button[data-testid='Decline all']", "button[data-testid='cookie-banner-reject']"] },
    { "domain": "amazon.com",          "selectors": ["#sp-cc-rejectall-link", "input[name='reject']"] },
    { "domain": "*.amazon.com",        "selectors": ["#sp-cc-rejectall-link", "input[name='reject']"] },
    { "domain": "*.amazon.co.uk",      "selectors": ["#sp-cc-rejectall-link"] },
    { "domain": "*.amazon.de",         "selectors": ["#sp-cc-rejectall-link"] },
    { "domain": "youtube.com",         "selectors": ["button[aria-label*='Reject all' i]", "button[aria-label*='Reject the use' i]", "tp-yt-paper-button[aria-label*='Reject' i]"] },
    { "domain": "*.youtube.com",       "selectors": ["button[aria-label*='Reject all' i]", "button[aria-label*='Reject the use' i]", "tp-yt-paper-button[aria-label*='Reject' i]"] },
    { "domain": "google.com",          "selectors": ["button[aria-label*='Reject all' i]", "button#W0wltc", "form[action*='consent'] button:nth-of-type(1)"] },
    { "domain": "*.google.com",        "selectors": ["button[aria-label*='Reject all' i]", "button#W0wltc"] },
    { "domain": "consent.google.com",  "selectors": ["button[aria-label*='Reject all' i]", "form[action*='deny'] button"] },
    { "domain": "consent.youtube.com", "selectors": ["button[aria-label*='Reject all' i]", "form[action*='deny'] button"] },
    { "domain": "reddit.com",          "selectors": ["button:has(span:contains('Reject non-essential'))", "button[id*='reject']"] },
    { "domain": "*.reddit.com",        "selectors": ["button[id*='reject']", "button[data-testid*='reject']"] },
    { "domain": "twitter.com",         "selectors": ["button[data-testid*='deny']", "button:has(span:contains('Refuse non-essential'))"] },
    { "domain": "x.com",               "selectors": ["button[data-testid*='deny']"] },
    { "domain": "linkedin.com",        "selectors": ["button[action-type='DENY']", "button[data-tracking-control-name='ga-cookie.consent.deny.v4']"] },
    { "domain": "*.linkedin.com",      "selectors": ["button[action-type='DENY']", "button[data-tracking-control-name='ga-cookie.consent.deny.v4']"] },
    { "domain": "github.com",          "selectors": ["form[action*='/cookies/reject'] button[type='submit']", "button[data-action*='reject']"] },
    { "domain": "stackoverflow.com",   "selectors": ["button.js-accept-cookies + button", "button:contains('Reject all')"] },
    { "domain": "*.stackexchange.com", "selectors": ["button.js-accept-cookies + button"] },
    { "domain": "netflix.com",         "selectors": ["button[data-uia*='cookie-disclosure-reject']"] },
    { "domain": "spotify.com",         "selectors": ["button#onetrust-reject-all-handler", "#onetrust-reject-all-handler"] },
    { "domain": "*.spotify.com",       "selectors": ["#onetrust-reject-all-handler"] },
    { "domain": "*.twitch.tv",         "selectors": ["button[data-a-target='consent-banner-decline']"] },
    { "domain": "ebay.com",            "selectors": ["#gdpr-banner-decline"] },
    { "domain": "*.ebay.com",          "selectors": ["#gdpr-banner-decline"] },
    { "domain": "walmart.com",         "selectors": ["button[aria-label*='Reject' i]"] },
    { "domain": "target.com",          "selectors": ["button[data-test='cookie-reject']"] },
    { "domain": "etsy.com",            "selectors": ["button[data-gdpr-single-choice-overlay-decline]", "button[data-gdpr-overlay-decline]"] },

    { "domain": "*.theguardian.com",   "selectors": ["button[data-link-name='Reject all']"] },
    { "domain": "*.bbc.com",           "selectors": ["#bbccookies-reject-button", "button[data-cookie-banner='reject']"] },
    { "domain": "*.bbc.co.uk",         "selectors": ["#bbccookies-reject-button", "button[data-cookie-banner='reject']"] },
    { "domain": "*.cnn.com",           "selectors": ["#onetrust-reject-all-handler"] },
    { "domain": "*.washingtonpost.com","selectors": ["button[data-qa='cookie-rejectall']", "button[data-qa='cookie-denyall']"] },
    { "domain": "*.reuters.com",       "selectors": ["#onetrust-reject-all-handler"] },
    { "domain": "*.apnews.com",        "selectors": ["#onetrust-reject-all-handler"] },
    { "domain": "*.lemonde.fr",        "selectors": ["button.didomi-button-reject", "#didomi-notice-disagree-button"] },
    { "domain": "*.zeit.de",           "selectors": ["button[data-tracking-action='Reject all']", "button[id*='reject']"] },
    { "domain": "*.spiegel.de",        "selectors": ["button[title='Nur notwendige Cookies'], button[data-component='ConsentReject']"] },

    { "comment": "OneTrust default — covers thousands of sites" , "domain": "*", "selectors": ["#onetrust-reject-all-handler"] },
    { "comment": "Cookiebot default",   "domain": "*", "selectors": ["#CybotCookiebotDialogBodyButtonDecline", "button#CybotCookiebotDialogBodyLevelButtonCustomize + button"] },
    { "comment": "Didomi default",      "domain": "*", "selectors": ["#didomi-notice-disagree-button", "button.didomi-button-reject", "button.didomi-components-button--color-reject"] },
    { "comment": "Quantcast default",   "domain": "*", "selectors": ["button[mode='primary'][aria-label*='Disagree']", "button.qc-cmp2-summary-buttons + button"] },
    { "comment": "TrustArc default",    "domain": "*", "selectors": ["a.call", "#truste-consent-required"] },
    { "comment": "Usercentrics default","domain": "*", "selectors": ["button[data-testid='uc-deny-all-button']"] },
    { "comment": "OptanonAlert default","domain": "*", "selectors": ["#optanon-allow-all + button", "button[onclick*='OptanonWrapper'][onclick*='deny']"] },
    { "comment": "TCF default reject",  "domain": "*", "selectors": ["button[data-action='reject-all']", "button.cookie-consent-reject", "button[id*='reject-all']", "button[aria-label*='Reject all' i]"] }
  ]
}
